\chapter{快速参考}

\section{操作流程速查}

\begin{center}
	\begin{tabular}{|c|l|l|}
		\hline
		\textbf{步骤} & \textbf{操作} & \textbf{说明}           \\
		\hline
		1           & 选择 PDF 文件   & 点击「选择 PDF 文件」按钮       \\
		2           & 开始识别        & 点击绿色「开始切题与识别」按钮       \\
		3           & 复制提示词       & 点击「Copy OCR Prompt」按钮 \\
		4           & 发送给 AI      & 在 AI 助手中粘贴提示词 + 识别结果  \\
		5           & 复制 AI 回复    & 复制 AI 返回的 JSON 代码     \\
		6           & 粘贴数据        & 在「数据编辑」选项卡中粘贴         \\
		7           & 生成 PDF      & 点击「生成 PDF 文件」按钮       \\
		\hline
	\end{tabular}
\end{center}

\section{文件位置说明}

\begin{center}
	\begin{tabular}{lp{8cm}}
		\toprule
		\textbf{文件}                   & \textbf{说明}      \\
		\midrule
		\texttt{setup.bat}            & 安装脚本，首次使用时双击运行   \\
		\texttt{run.vbs}              & 启动脚本，每次使用时双击运行   \\
		\texttt{output/} 文件夹          & 生成的 PDF 保存在这里    \\
		\texttt{output/pdf\_ocr/} 文件夹 & OCR 识别的中间文件（图片等） \\
		\bottomrule
	\end{tabular}
\end{center}

